# AIOS — variabili d'ambiente (copia in .env.local per sviluppo locale)
# Su Fly.io: `fly secrets set NOME=valore` (MAI committare valori reali qui)

# --- Radice dati (AIOS_ROOT) ---
# Directory che contiene projects/, agents/, config/, mcp/. Default: radice del
# repo (tre livelli sopra src/lib/aios/). In container va puntata al volume
# montato (fly.toml la imposta a /data). In `next dev` NON serve definirla.
# AIOS_ROOT=/data

# --- AIOS runner ---
# Provider/modello/chiavi si impostano anche dal pannello Impostazioni (⚙️) in
# alto a destra nella dashboard, che ha PRECEDENZA su queste variabili e si
# persiste in config/llm_settings.local.json SUL VOLUME (gitignored, mai
# nell'immagine). Queste env restano il fallback all'avvio a freddo, prima che
# qualcuno apra il pannello.
#
# mock = agenti simulati (default, no chiavi necessarie)
# claude = provider Anthropic reale (richiede ANTHROPIC_API_KEY)
AIOS_RUNNER=mock
ANTHROPIC_API_KEY=
# Fallback per il provider OpenAI-compatibile (endpoint via UI o proxy):
OPENAI_API_KEY=

# --- Vercel ---
# Impostata automaticamente da Vercel a "1" in build/preview/production.
# NOTA: Vercel/serverless NON è un target di deploy supportato — vedi
# docs/DEPLOY.md §1 per il perché (stato in memoria di processo + FS read-only).
# VERCEL=1
